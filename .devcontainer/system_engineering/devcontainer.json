{
    "image": "ghcr.io/renn0xtek9/robot_system_engineering_environment:0.0.1",
    "name": "Robot System Engineering",
    "customizations": {
        "vscode": {
            "extensions": [
                "jebbs.plantuml",
                "MermaidChart.vscode-mermaid-chart"
            ]
        }
    },
    "mounts": [
        "source=${localEnv:HOME}/.ssh,target=/home/ubuntu/.ssh,type=bind,consistency=cached",
        "source=${localEnv:HOME}/.gitconfig,target=${env:HOME}/.gitconfig,type=bind,consistency=cached",
        "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind",
    ],
    "remoteUser": "ubuntu",
    "features": {
        "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
            "enableNonRootDocker": true
        }
    },
    "remoteEnv": {
        "GH_TOKEN": "${localEnv:GH_TOKEN}"
    }
}
