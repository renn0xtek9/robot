# Apache Virtual Host Configuration for HTTPS APT Repository with mTLS

<VirtualHost *:443>

    ServerName {{ apt_server_hostname }}
    ServerAdmin admin@{{ apt_server_hostname }}

    ###########################################################################
    # SSL/TLS Configuration
    ###########################################################################

    SSLEngine on

    SSLProtocol TLSv1.2 TLSv1.3

    SSLCipherSuite ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384

    SSLHonorCipherOrder on

    ###########################################################################
    # Server Certificate
    ###########################################################################

    SSLCertificateFile {{ apt_server_cert_path }}
    SSLCertificateKeyFile {{ apt_server_key_path }}

    ###########################################################################
    # Client Certificate Verification (mTLS)
    ###########################################################################

    SSLVerifyClient require
    SSLVerifyDepth 10

    SSLCACertificateFile {{ apt_server_ca_cert_path }}
    SSLCACertificatePath {{ apt_server_ca_cert_dir }}

    ###########################################################################
    # Repository Root
    ###########################################################################

    DocumentRoot /var/www/packages

    <Directory /var/www/packages>
        Options Indexes FollowSymLinks
        AllowOverride None
        Require all granted
    </Directory>

    ###########################################################################
    # MIME Types
    ###########################################################################

    AddType application/vnd.debian.binary-package .deb
    AddType text/plain .list

    ###########################################################################
    # Compression
    ###########################################################################

    <IfModule mod_deflate.c>
        AddOutputFilterByType DEFLATE \
            text/plain \
            text/html \
            text/xml \
            text/css \
            application/json
    </IfModule>

    ###########################################################################
    # Client Certificate Headers
    ###########################################################################

    RequestHeader set X-Client-Subject "%{SSL_CLIENT_S_DN}e"
    RequestHeader set X-Client-Issuer "%{SSL_CLIENT_I_DN}e"

    ###########################################################################
    # Logging
    ###########################################################################

    ErrorLog ${APACHE_LOG_DIR}/apt-server-error.log
    CustomLog ${APACHE_LOG_DIR}/apt-server-access.log combined

</VirtualHost>

###############################################################################
# HTTP -> HTTPS Redirect
###############################################################################

<VirtualHost *:80>

    ServerName {{ apt_server_hostname }}

    RewriteEngine On
    RewriteRule ^/(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

</VirtualHost>
